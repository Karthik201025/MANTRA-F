# Local-only provider configuration. Never commit real values.
# Shared server-side AI gateway. Cloudflare REST is selected when account credentials exist.
AI_GATEWAY_URL=
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=
AI_GATEWAY_TIMEOUT_MS=15000
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
